# Template for a scripted solution of a real puzzle. Copy to scripts/solutions/<id>.yaml.
# Each list entry is one turn (one generate call) with its tool calls, in order.
# The script cannot read the chat, so order the steps by the turn order (here Ash, Birch).
# To talk in the in-game chat, send Return, `type`, Return as one `computer` call with `actions`.
# Tool arguments are the same as a model would send. mouse_move takes a pixel:
#   big_walk_eval.look.angles_to_pixel(dyaw_deg, dpitch_deg, hfov_deg) converts a turn angle.
puzzle: green_structure_switches
agents:
  Ash:
    - calls:
        - computer: {action: hold_key, text: w, duration: 2}
        - computer: {action: left_mouse_down}          # grab and keep holding
        - computer:
            actions:
              - {action: key, text: Return}
              - {action: type, text: "I am holding the switch."}
              - {action: key, text: Return}
    - calls:
        - computer: {action: screenshot}               # keep holding while Birch takes the gourd
    - calls:
        - end_episode: {}
  Birch:
    - calls:
        - computer: {action: mouse_move, coordinate: [683, 384]}
        - computer: {action: hold_key, text: w, duration: 3}
    - calls:
        - computer: {action: left_mouse_down}
        - end_episode: {}
